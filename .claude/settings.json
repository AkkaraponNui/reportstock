{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run python tools/fetch_fundamentals.py:*)",
      "Bash(uv run python tools/fetch_news.py:*)",
      "Bash(uv run python tools/fetch_filings.py:*)",
      "Bash(uv run python tools/score.py:*)",
      "Bash(uv run python tools/build_report.py:*)",
      "Bash(uv run python tools/search_tickers.py:*)",
      "Bash(uv run python tools/predict.py:*)",
      "Bash(uv run python -m streamlit run app.py:*)",
      "Bash(uv run python -c:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Read(./data/**)",
      "Read(./config/**)",
      "Read(./tools/**)",
      "Write(./data/**)",
      "WebFetch(domain:www.sec.gov)",
      "WebFetch(domain:data.sec.gov)",
      "WebFetch(domain:finance.yahoo.com)",
      "WebFetch(domain:www.reuters.com)",
      "WebFetch(domain:www.bloomberg.com)",
      "WebFetch(domain:www.cnbc.com)",
      "WebFetch(domain:www.ft.com)",
      "WebFetch(domain:www.wsj.com)",
      "WebFetch(domain:news.google.com)"
    ],
    "deny": []
  },
  "env": {
    "PYTHONIOENCODING": "utf-8"
  }
}

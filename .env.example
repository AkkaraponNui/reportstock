# Required before using SEC EDGAR. EDGAR throttles anonymous traffic.
REPORTSTOCK_UA="Your Name your@email.com"

# Required only for the chat page. Every other page works without it.
# Billed per use at Anthropic's API rates. Get one at console.anthropic.com,
# or run `ant auth login` and the SDK finds the profile on its own.
# ANTHROPIC_API_KEY=

# Optional. Everything works without these; they only add news depth.
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Set this to turn on the shared-password gate. Leave unset when running
# on your own machine; always set it on a public URL.
# APP_PASSWORD=
